{
  "name": "@tyler9061/dsh-auth",
  "version": "0.1.7",
  "description": "dsh web 认证插件：登录保护、空闲自动登出、认证有效期、设置界面、`dsh web p` 重置密码",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "plugin",
    "auth",
    "authentication",
    "security"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/optttt/dsh-auth.git"
  },
  "homepage": "https://github.com/optttt/dsh-auth#readme",
  "bugs": {
    "url": "https://github.com/optttt/dsh-auth/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
